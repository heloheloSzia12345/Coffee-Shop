<!DOCTYPE html>
<html>
  <head>
    <title>Fekete Macska Kávézó</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", media: "all" %>
  </head>

  <body class="<%= 'dark-mode' if session[:dark_mode] %>">
    <header class="app-header">
      <div class="logo">☕ <%= tr(:app_title) %></div>
      <nav class="nav-links">
        <% if current_user %>
          <% cart_count = Order.current_cart_for(current_user).order_items.sum(:quantity) %>
          <%= link_to tr(:dashboard), dashboard_path %>
          <%= link_to tr(:profile), profile_path %>
          <%= link_to tr(:offers), offers_path %>
          <%= link_to "#{tr(:cart)} (#{cart_count})", cart_path %>
          <%= link_to tr(:settings), settings_path %>
          <%= link_to "#{tr(:logout)} (#{current_user.first_name})", logout_path, data: { "turbo-method": :delete } %>
        <% else %>
          <%= link_to tr(:login), login_path %>
          <%= link_to tr(:register), register_path %>
        <% end %>
      </nav>
    </header>

    <main class="container">
      <% if flash[:notice] %>
        <div class="flash notice" style="background: #e8f5e9; color: #2e7d32; padding: 10px; margin-bottom: 15px; border-radius: 4px; border: 1px solid #c8e6c9;">
          <%= flash[:notice] %>
        </div>
      <% end %>
      <% if flash[:alert] %>
        <div class="flash alert" style="background: #ffebee; color: #c62828; padding: 10px; margin-bottom: 15px; border-radius: 4px; border: 1px solid #ffcdd2;">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
