<div class="card">
  <h2>Kosarad</h2>

  <% if @order.order_items.any? %>
    <ul class="cart-list">
      <% @order.order_items.each do |item| %>
        <li style="align-items: center;">
          <div>
            <strong><%= item.product.name %></strong><br />
            <small><%= item.unit_price %> Ft / db</small>
          </div>
          
          <div style="display: flex; align-items: center; gap: 8px;">
            <%= button_to "-", decrease_cart_item_path(item.id), method: :patch, class: "btn-sm", style: "border: none; cursor: pointer;" %>
            <span><strong><%= item.quantity %> db</strong></span>
            <%= button_to "+", increase_cart_item_path(item.id), method: :patch, class: "btn-sm", style: "border: none; cursor: pointer;" %>
            <span style="min-width: 75px; text-align: right; font-weight: bold;"><%= item.unit_price * item.quantity %> Ft</span>
          </div>
        </li>
      <% end %>
    </ul>

    <div class="price-summary">
      <p>Rendelés összege: <strong><%= @order.subtotal %> Ft</strong></p>
      <p style="font-size: 1.15rem;"><strong>Fizetendő: <%= @order.calculated_total %> Ft</strong></p>
    </div>

    <hr />

    <h3>Fizetés részletei</h3>
    <%= form_with url: orders_path, method: :post, local: true do |f| %>
      <div class="form-group">
        <%= f.label :name, "Teljes név:" %>
        <%= f.text_field :name, value: @user.name, readonly: true %>
      </div>

      <div class="form-group">
        <%= f.label :phone, "Telefonszám:" %>
        <%= f.text_field :phone, value: @user.phone %>
      </div>

      <div class="form-group">
        <%= f.label :notes, "Kiegészítések:" %>
        <%= f.text_area :notes, rows: 2, placeholder: "pl. Kevesebb cukorral" %>
      </div>

      <% if @user.points >= 10 %>
        <div class="form-group-checkbox loyalty-box">
          <%= f.check_box :use_points %>
          <%= f.label :use_points, "10 hűségpont beváltása (-500 Ft kedvezmény)!" %>
        </div>
      <% end %>

      <div class="form-group">
        <label style="display: block; margin-bottom: 8px;">Fizetési mód:</label>
        <div style="display: flex; gap: 24px; align-items: center;">
          <label style="display: inline-flex; align-items: center; gap: 6px; width: auto; margin: 0; font-weight: normal; cursor: pointer;">
            <%= f.radio_button :payment_method, "Készpénz", checked: true, style: "width: auto; margin: 0;" %> Készpénz
          </label>
          <label style="display: inline-flex; align-items: center; gap: 6px; width: auto; margin: 0; font-weight: normal; cursor: pointer;">
            <%= f.radio_button :payment_method, "Bankkártya", style: "width: auto; margin: 0;" %> Bankkártya
          </label>
        </div>
      </div>

      <div style="display: flex; justify-content: space-between; margin-top: 20px;">
        <%= link_to "← További termékek", offers_path, class: "btn btn-secondary" %>
        <%= f.submit "Megrendelés leadása", class: "btn" %>
      </div>
    <% end %>
  <% else %>
    <p>A kosarad jelenleg üres.</p>
    <%= link_to "Irány az ajánlatokhoz", offers_path, class: "btn" %>
  <% end %>
</div>
