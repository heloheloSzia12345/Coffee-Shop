<div class="card">
  <h2>Kosarad</h2>

  <ul class="cart-list">
    <% if @order && @order.order_items.any? %>
      <% @order.order_items.each do |item| %>
        <li>
          <span><%= item.quantity %>x <%= item.product.name %></span>
          <span><%= item.unit_price * item.quantity %> Ft</span>
        </li>
      <% end %>
    <% else %>
      <li>A kosár jelenleg üres.</li>
    <% end %>
  </ul>

  <div class="price-summary">
    <p>Rendelés összege: <strong><%= @order ? @order.calculated_total : 0 %> Ft</strong></p>
    <p>Kedvezmény (hűségpontok): <strong>-<%= @order ? @order.discount : 0 %> Ft</strong></p>
    <p style="font-size: 1.1rem; color: #5d4037;"><strong>Fizetendő: <%= @order ? @order.calculated_total : 0 %> Ft</strong></p>
  </div>

  <hr />

  <h3>Fizetés részletei</h3>
  <%= form_with url: orders_path, method: :post, local: true do |f| %>
    <div class="form-group">
      <%= f.label :name, "Teljes név:" %>
      <%= f.text_field :name, value: @user.name, readonly: true %>
    </div>

    <div class="form-group">
      <%= f.label :phone, "Telefonszám:" %>
      <%= f.text_field :phone, value: @user.phone %>
    </div>

    <div class="form-group">
      <%= f.label :notes, "Kiegészítések:" %>
      <%= f.text_area :notes, rows: 2, placeholder: "pl. Kevesebb cukorral" %>
    </div>

    <div class="form-group">
      <label>Fizetési mód:</label><br />
      <label><%= f.radio_button :payment_method, "Készpénz", checked: true %> Készpénz</label>
      <label style="margin-left: 15px;"><%= f.radio_button :payment_method, "Bankkártya" %> Bankkártya</label>
    </div>

    <%= f.submit "Megrendelés leadása", class: "btn" %>
  <% end %>
</div>
