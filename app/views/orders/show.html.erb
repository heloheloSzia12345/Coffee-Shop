<div class="card confirmation">
  <h2>Köszönjük a megrendelést!</h2>
  <p>Rendelésszám: <strong><%= @order.order_number %></strong></p>
  <p>Várható elkészülés: <strong>~<%= @order.estimated_time %></strong></p>

  <hr />

  <h3>Megrendelés részletei</h3>
  <ul class="cart-list">
    <% @order.items.each do |item| %>
      <li>
        <span><%= item[:quantity] %>x <%= item[:name] %></span>
        <span><%= item[:price] * item[:quantity] %> Ft</span>
      </li>
    <% end %>
  </ul>
  <p>Kedvezmény: -<%= @order.discount %> Ft</p>
  <p><strong>Végösszeg: <%= @order.total %> Ft</strong></p>

  <div class="loyalty-box">
    +1 pont hozzáadva a fiókodhoz! (Új egyenleg: <%= @user.points + 1 %> / <%= @user.max_points %> pont)
  </div>

  <div style="margin-top: 25px;">
    <%= link_to "Vissza a kezdőlapra", dashboard_path, class: "btn" %>
  </div>
</div>
