<div class="card">
  <h2>Lépj be a törzsvendég fiókodba, vagy csatlakozz hozzánk!</h2>
  
  <%= form_with url: login_path, method: :post, local: true do |f| %>
    <div class="form-group">
      <%= f.label :email, "Email cím" %>
      <%= f.email_field :email, placeholder: "pelda@email.hu" %>
    </div>

    <div class="form-group">
      <%= f.label :password, "Jelszó" %>
      <%= f.password_field :password %>
    </div>

    <div class="form-group-checkbox">
      <%= f.check_box :remember_me %>
      <%= f.label :remember_me, "Emlékezz rám!" %>
    </div>

    <%= f.submit "Bejelentkezés", class: "btn" %>
  <% end %>

  <p class="sub-text">
    Még nincs fiókod? <%= link_to "Regisztrálj itt!", register_path %>
  </p>
</div>
