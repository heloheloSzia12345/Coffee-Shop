<div class="card">
  <h2>Regisztráció</h2>

  <%= form_with model: @user, url: register_path, local: true do |f| %>
    <div class="form-group">
      <%= f.label :name, "Teljes név" %>
      <%= f.text_field :name %>
    </div>

    <div class="form-group">
      <%= f.label :birth_date, "Születési dátum 📅" %>
      <%= f.date_field :birth_date %>
    </div>

    <div class="form-group">
      <%= f.label :email, "Email cím" %>
      <%= f.email_field :email %>
    </div>

    <div class="form-group">
      <%= f.label :password, "Jelszó" %>
      <%= f.password_field :password %>
    </div>

    <div class="form-group">
      <%= f.label :password_confirmation, "Jelszó megerősítése" %>
      <%= f.password_field :password_confirmation %>
    </div>

    <%= f.submit "Regisztráció", class: "btn" %>
  <% end %>
</div>
