<div class="card">
  <h2><%= tr(:settings) %></h2>

  <%= form_with url: update_settings_path, method: :post, local: true do |f| %>
    <div class="form-group">
      <label for="language"><%= tr(:language) %></label>
      <%= select_tag "language", options_for_select(@languages, session[:language] || "Magyar") %>
    </div>

    <div class="form-group-checkbox">
      <%= check_box_tag "dark_mode", "1", session[:dark_mode] %>
      <%= label_tag "dark_mode", tr(:dark_mode) %>
    </div>

    <%= f.submit tr(:save), class: "btn" %>
  <% end %>
</div>
